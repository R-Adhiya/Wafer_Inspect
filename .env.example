# ---------------------------------------------------------------------------
# WaferInspect Environment Configuration Example
# ---------------------------------------------------------------------------

# Base data directory for SQLite database, image uploads, and inspection artifacts
# Defaults to <repo root>/data locally, or /data in Docker
DATA_DIR=data

# Database connection URL
# Default SQLite:
DATABASE_URL=sqlite:///data/waferinspect.db
# PostgreSQL alternative (used with docker compose --profile postgres):
# DATABASE_URL=postgresql+psycopg://waferinspect:waferinspect@localhost:5432/waferinspect

# Upload and Image Constraints
MAX_UPLOAD_SIZE=20971520      # 20 MB maximum upload size
MIN_IMAGE_DIMENSION=64        # Minimum wafer width/height in pixels
MAX_IMAGE_DIMENSION=4096      # Maximum wafer width/height in pixels
MAX_IMAGE_PIXELS=16777216     # 4096 x 4096 (peak process memory < 2 GB)

# API and CORS Configuration
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# Future ML patch classifier weights path (reserved for post-1.0 PyTorch model)
MODEL_PATH=models/waferinspect_model.pt
