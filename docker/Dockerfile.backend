FROM python:3.12-slim

# Install system dependencies for OpenCV and healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and directories
RUN useradd -m -u 1000 -s /bin/bash appuser && \
    mkdir -p /app /data /data/uploads /data/results && \
    chown -R appuser:appuser /app /data

WORKDIR /app

# Install Python requirements (including PostgreSQL support)
COPY backend/requirements.txt .
COPY backend/requirements-postgres.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -r requirements-postgres.txt

# Copy backend application and database migration files
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY docker/entrypoint.sh ./entrypoint.sh

RUN chmod +x ./entrypoint.sh && \
    chown -R appuser:appuser /app

USER appuser

ENV PYTHONPATH=/app
ENV DATA_DIR=/data
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
VOLUME ["/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
